{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "timeline.track@1",
  "registrations": {},
  "tokenDefaults": {
    "--corner-signal-timeline-unit": "min(calc(100cqw / 1129),calc(100cqh / 417))",
    "--corner-signal-timeline-n": "4",
    "--corner-signal-timeline-i": "0",
    "--corner-signal-timeline-x": "calc((100cqw - var(--corner-signal-timeline-unit)*1129)/2)",
    "--corner-signal-timeline-y": "calc((100cqh - var(--corner-signal-timeline-unit)*417)/2)",
    "--corner-signal-timeline-advance": "calc(813/(var(--corner-signal-timeline-n) - 1))",
    "--corner-signal-timeline-pad": "54",
    "--corner-signal-timeline-on": "var(--page)"
  }
}