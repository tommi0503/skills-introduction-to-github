{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "steps.sequence@1",
  "registrations": {},
  "tokenDefaults": {
    "--corner-signal-steps-unit": "min(calc(100cqw / 1128),calc(100cqh / 390))",
    "--corner-signal-steps-n": "4",
    "--corner-signal-steps-i": "0",
    "--corner-signal-steps-x": "calc((100cqw - var(--corner-signal-steps-unit)*1128)/2)",
    "--corner-signal-steps-y": "calc((100cqh - var(--corner-signal-steps-unit)*390)/2)",
    "--corner-signal-steps-w": "calc((1128 - (var(--corner-signal-steps-n) - 1)*9.333)/var(--corner-signal-steps-n))"
  }
}