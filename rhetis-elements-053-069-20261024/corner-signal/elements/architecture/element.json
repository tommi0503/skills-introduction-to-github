{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "architecture.layers@1",
  "registrations": {},
  "tokenDefaults": {
    "--corner-signal-architecture-unit": "min(calc(100cqw / 707),calc(100cqh / 392))",
    "--corner-signal-architecture-n": "3",
    "--corner-signal-architecture-i": "0",
    "--corner-signal-architecture-x": "calc((100cqw - var(--corner-signal-architecture-unit)*707)/2)",
    "--corner-signal-architecture-y": "calc((100cqh - var(--corner-signal-architecture-unit)*392)/2)",
    "--corner-signal-architecture-w": "calc((707 - (var(--corner-signal-architecture-n) - 1)*55)/var(--corner-signal-architecture-n))"
  }
}