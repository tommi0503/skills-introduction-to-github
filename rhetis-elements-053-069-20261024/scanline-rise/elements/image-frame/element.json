{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "frame.picture@1",
  "registrations": {},
  "tokenDefaults": {
    "--scanline-rise-image-frame-unit": "min(calc(100cqw / 196),calc(100cqh / 390))",
    "--scanline-rise-image-frame-fw": "min(100cqw,50.256410cqh)",
    "--scanline-rise-image-frame-fh": "min(100cqh,198.979592cqw)",
    "--scanline-rise-image-frame-fx": "calc((100cqw - var(--scanline-rise-image-frame-fw))/2)",
    "--scanline-rise-image-frame-fy": "calc((100cqh - var(--scanline-rise-image-frame-fh))/2)"
  }
}