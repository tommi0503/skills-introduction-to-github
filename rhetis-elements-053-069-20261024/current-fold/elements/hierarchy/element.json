{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "hierarchy.org@1",
  "registrations": {},
  "tokenDefaults": {
    "--current-fold-hierarchy-unit": "min(calc(100cqw / 512),calc(100cqh / 410))",
    "--current-fold-hierarchy-n": "3",
    "--current-fold-hierarchy-i": "0",
    "--current-fold-hierarchy-bw": "max(512,calc(var(--current-fold-hierarchy-n)*178 - 22))",
    "--current-fold-hierarchy-x": "calc((100cqw - var(--current-fold-hierarchy-unit)*var(--current-fold-hierarchy-bw))/2)",
    "--current-fold-hierarchy-y": "calc((100cqh - var(--current-fold-hierarchy-unit)*410)/2)",
    "--current-fold-hierarchy-gx": "calc((var(--current-fold-hierarchy-bw) - (var(--current-fold-hierarchy-n)*178 - 22))/2)"
  }
}