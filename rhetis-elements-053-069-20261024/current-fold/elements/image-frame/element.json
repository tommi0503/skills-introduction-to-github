{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "frame.picture@1",
  "registrations": {},
  "tokenDefaults": {
    "--current-fold-image-frame-unit": "min(calc(100cqw / 338),calc(100cqh / 553))",
    "--current-fold-image-frame-fw": "min(100cqw,61.121157cqh)",
    "--current-fold-image-frame-fh": "min(100cqh,163.609467cqw)",
    "--current-fold-image-frame-fx": "calc((100cqw - var(--current-fold-image-frame-fw))/2)",
    "--current-fold-image-frame-fy": "calc((100cqh - var(--current-fold-image-frame-fh))/2)"
  }
}