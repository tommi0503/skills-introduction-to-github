{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "steps.sequence@1",
  "registrations": {},
  "tokenDefaults": {
    "--current-fold-steps-unit": "min(calc(100cqw / 1093),calc(100cqh / 488))",
    "--current-fold-steps-n": "5",
    "--current-fold-steps-i": "0",
    "--current-fold-steps-y": "calc(var(--current-fold-steps-unit)*(16 + (var(--current-fold-steps-n) - 1 - var(--current-fold-steps-i))*289/(var(--current-fold-steps-n) - 1)))",
    "--current-fold-steps-fill": "var(--a2)",
    "--current-fold-steps-on": "var(--a2-on)"
  }
}