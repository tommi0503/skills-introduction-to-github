{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "frame.picture@1",
  "registrations": {},
  "tokenDefaults": {
    "--anchor-frame-image-frame-unit": "min(calc(100cqw / 349),calc(100cqh / 268))",
    "--anchor-frame-image-frame-vw": "349",
    "--anchor-frame-image-frame-vh": "268",
    "--anchor-frame-image-frame-bw": "343",
    "--anchor-frame-image-frame-bh": "262",
    "--anchor-frame-image-frame-u": "min(calc(100cqw / var(--anchor-frame-image-frame-vw)),calc(100cqh / var(--anchor-frame-image-frame-vh)))",
    "--anchor-frame-image-frame-x": "calc((100cqw - var(--anchor-frame-image-frame-u)*var(--anchor-frame-image-frame-vw))/2)",
    "--anchor-frame-image-frame-y": "calc((100cqh - var(--anchor-frame-image-frame-u)*var(--anchor-frame-image-frame-vh))/2)"
  }
}