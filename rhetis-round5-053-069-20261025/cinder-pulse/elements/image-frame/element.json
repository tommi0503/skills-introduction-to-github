{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "frame.picture@1",
  "registrations": {},
  "tokenDefaults": {
    "--cinder-pulse-image-frame-unit": "min(calc(100cqw / 283),calc(100cqh / 283))",
    "--cinder-pulse-image-frame-fw": "min(100cqw,100.000000cqh)",
    "--cinder-pulse-image-frame-fh": "min(100cqh,100.000000cqw)",
    "--cinder-pulse-image-frame-fx": "calc((100cqw - var(--cinder-pulse-image-frame-fw))/2)",
    "--cinder-pulse-image-frame-fy": "calc((100cqh - var(--cinder-pulse-image-frame-fh))/2)"
  }
}