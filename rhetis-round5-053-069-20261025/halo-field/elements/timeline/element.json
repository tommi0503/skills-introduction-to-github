{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "timeline.track@1",
  "registrations": {},
  "tokenDefaults": {
    "--halo-field-timeline-unit": "min(calc(100cqw / 1180),calc(100cqh / 425))",
    "--halo-field-timeline-n": "4",
    "--halo-field-timeline-i": "0",
    "--halo-field-timeline-w": "calc((1172 - (var(--halo-field-timeline-n) - 1)*18)/var(--halo-field-timeline-n))",
    "--halo-field-timeline-x": "calc((100cqw - var(--halo-field-timeline-unit)*1180)/2 + var(--halo-field-timeline-unit)*8)",
    "--halo-field-timeline-y": "calc((100cqh - var(--halo-field-timeline-unit)*425)/2)",
    "--halo-field-timeline-gray": "var(--n-3)"
  }
}