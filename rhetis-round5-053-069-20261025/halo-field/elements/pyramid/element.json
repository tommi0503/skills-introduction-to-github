{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "pyramid.levels@1",
  "registrations": {},
  "tokenDefaults": {
    "--halo-field-pyramid-unit": "min(calc(100cqw / 1172),calc(100cqh / 425))",
    "--halo-field-pyramid-n": "4",
    "--halo-field-pyramid-i": "0",
    "--halo-field-pyramid-x": "calc((100cqw - var(--halo-field-pyramid-unit)*1172)/2)",
    "--halo-field-pyramid-y": "calc((100cqh - var(--halo-field-pyramid-unit)*425)/2)",
    "--halo-field-pyramid-top": "calc(7 + var(--halo-field-pyramid-i)*322/(var(--halo-field-pyramid-n) - 1))",
    "--halo-field-pyramid-w": "calc(98 + var(--halo-field-pyramid-i)*370/(var(--halo-field-pyramid-n) - 1))",
    "--halo-field-pyramid-h": "67",
    "--halo-field-pyramid-cap": "36",
    "--halo-field-pyramid-point": "calc(234 + var(--halo-field-pyramid-i)*164/(var(--halo-field-pyramid-n) - 1))",
    "--halo-field-pyramid-gray": "var(--n-5)"
  }
}