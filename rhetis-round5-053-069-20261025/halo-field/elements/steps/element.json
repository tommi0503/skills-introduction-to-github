{
  "schema": "rhetis.design-library-element-source/1",
  "contract": "steps.sequence@1",
  "registrations": {},
  "tokenDefaults": {
    "--halo-field-steps-unit": "min(calc(100cqw / 1172),calc(100cqh / 425))",
    "--halo-field-steps-n": "6",
    "--halo-field-steps-i": "0",
    "--halo-field-steps-x": "calc((100cqw - var(--halo-field-steps-unit)*1172)/2)",
    "--halo-field-steps-y": "calc((100cqh - var(--halo-field-steps-unit)*425)/2)",
    "--halo-field-steps-advance": "calc(var(--halo-field-steps-unit)*1094/var(--halo-field-steps-n))",
    "--halo-field-steps-left": "calc(var(--halo-field-steps-x) + var(--halo-field-steps-unit)*36 + var(--halo-field-steps-i)*var(--halo-field-steps-advance))",
    "--halo-field-steps-width": "calc(var(--halo-field-steps-advance) + var(--halo-field-steps-unit)*26)"
  }
}