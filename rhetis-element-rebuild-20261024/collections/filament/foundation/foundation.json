{
  "schema": "rhetis.design-library-foundation-source/1",
  "kit": "filament",
  "registrations": {},
  "tokenDefaults": {
    "--filament-grid-gap": "var(--gap)",
    "--filament-grid-columns": "repeat(12,minmax(0,1fr))",
    "--filament-grid-rows": "repeat(6,minmax(0,1fr))",
    "--filament-furn-x": "var(--margin-x)",
    "--filament-furn-y": "var(--margin-y)",
    "--filament-furn-w": "calc(1280px - var(--margin-x)*2)",
    "--filament-furn-h": "160px",
    "--filament-furn-font-ratio": ".065",
    "--filament-furn-font-size": "var(--type-14)",
    "--filament-furn-surface": "transparent",
    "--filament-furn-foreground": "inherit",
    "--filament-furn-align": "left",
    "--filament-body-x": "var(--margin-x)",
    "--filament-body-y": "var(--margin-y)",
    "--filament-body-w": "calc(1280px - var(--margin-x)*2)",
    "--filament-body-h": "calc(720px - var(--margin-y)*2)",
    "--filament-surface": "var(--page)",
    "--filament-foreground": "var(--ink)",
    "--filament-furn-depth": "0",
    "--filament-furn-rotation": "0deg"
  }
}