{
  "schema": "rhetis.design-library-foundation-source/1",
  "kit": "portico",
  "registrations": {},
  "tokenDefaults": {
    "--portico-grid-gap": "var(--gap)",
    "--portico-grid-columns": "repeat(12,minmax(0,1fr))",
    "--portico-grid-rows": "repeat(6,minmax(0,1fr))",
    "--portico-furn-x": "var(--margin-x)",
    "--portico-furn-y": "var(--margin-y)",
    "--portico-furn-w": "calc(1280px - var(--margin-x)*2)",
    "--portico-furn-h": "160px",
    "--portico-furn-font-ratio": ".065",
    "--portico-furn-font-size": "var(--type-14)",
    "--portico-furn-surface": "transparent",
    "--portico-furn-foreground": "inherit",
    "--portico-furn-align": "left",
    "--portico-body-x": "var(--margin-x)",
    "--portico-body-y": "var(--margin-y)",
    "--portico-body-w": "calc(1280px - var(--margin-x)*2)",
    "--portico-body-h": "calc(720px - var(--margin-y)*2)",
    "--portico-surface": "var(--page)",
    "--portico-foreground": "var(--ink)",
    "--portico-furn-depth": "0"
  }
}