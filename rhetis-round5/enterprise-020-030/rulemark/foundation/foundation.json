{
  "schema": "rhetis.design-library-foundation-source/1",
  "kit": "rulemark",
  "registrations": {},
  "tokenDefaults": {
    "--rulemark-grid-gap": "var(--gap)",
    "--rulemark-grid-columns": "repeat(12,minmax(0,1fr))",
    "--rulemark-grid-rows": "repeat(6,minmax(0,1fr))",
    "--rulemark-furn-x": "var(--margin-x)",
    "--rulemark-furn-y": "var(--margin-y)",
    "--rulemark-furn-w": "calc(1280px - var(--margin-x)*2)",
    "--rulemark-furn-h": "160px",
    "--rulemark-furn-font-ratio": ".065",
    "--rulemark-furn-font-size": "var(--type-14)",
    "--rulemark-furn-surface": "transparent",
    "--rulemark-furn-foreground": "inherit",
    "--rulemark-furn-align": "left",
    "--rulemark-body-x": "var(--margin-x)",
    "--rulemark-body-y": "var(--margin-y)",
    "--rulemark-body-w": "calc(1280px - var(--margin-x)*2)",
    "--rulemark-body-h": "calc(720px - var(--margin-y)*2)",
    "--rulemark-surface": "var(--n-1)",
    "--rulemark-foreground": "var(--ink)",
    "--rulemark-furn-depth": "0"
  }
}