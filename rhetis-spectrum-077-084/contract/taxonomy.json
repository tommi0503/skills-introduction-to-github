  "foundation": {
    "contract": "foundation.page@1",
    "category": "foundation.page",
    "classes": [
      "slide",
      "dark",
      "cover",
      "page",
      "head",
      "center",
      "kicker",
      "title",
      "lead",
      "body",
      "group",
      "col",
      "two",
      "three",
      "stack",
      "split",
      "wide-left",
      "icon",
      "top",
      "rail",
      "foot",
      "idx",
      "deck",
      "sec",
      "src",
      "no",
      "label",
      "on",
      "seat",
      "avatar",
      "portrait",
      "logo",
      "back",
      "lockup",
      "at-center",
      "at-left",
      "at-bottom-left",
      "at-top-left",
      "meta",
      "deco",
      "overrides"
    ],
    "parts": {
      "seat": "`.seat[data-ph=\"N\"]` — a numbered seat for what the page cannot draw (an image, a 3D model); variants `.seat.avatar` `.seat.portrait` `.seat.logo` `.seat.back` `.seat.icon`. A seat is a placement, not a material."
    },
    "structure": "`<section class=\"slide [dark]\"><div class=\"page\"><header class=\"head [center]\"><p class=\"kicker\">…</p><h1 class=\"title\">…</h1><p class=\"lead\">…</p></header><div class=\"body\">…grid children…</div></div></section>`. `.body` is a 12-column x 6-row grid; each body child states only `style=\"grid-column:A / span N; grid-row:B / span M\"`. `.group` (a row of equal members; `.group.col` `.group.two` `.group.three`), `.stack` (a column), `.split` (two columns, first narrower; `.split.wide-left` reverses) hold several members of one slot. A cover is `class=\"slide cover\"`: no head/body; `.page` holds a `.lockup` (`.kicker` + `.title` + `.lead`) placed with `.at-center` `.at-left` `.at-bottom-left` `.at-top-left`, an optional `.meta` line, and optional `.deco` (the foundation's cover graphic) or `.seat.back`."
  },
  "parts": [
    "parts",
    "kick",
    "fig",
    "name",
    "note",
    "mark"
  ],
  "contracts": [
    {
      "id": "card.parts@1",
      "category": "surface.card",
      "roots": [
        "card"
      ],
      "structure": "`.card` > `.parts` — variants `.on` (emphasis: accent fill) `.quiet` `.line` (outlined) `.tone-1…5`. Text parts inside `.parts`: `.kick` (small line above) `.fig` (the figure; `<small>` for its unit) `.name` `.note` `.mark` (icon or number)."
    },
    {
      "id": "pill.parts@1",
      "category": "surface.pill",
      "roots": [
        "pill"
      ],
      "structure": "`.pill` > `.parts` — a one-line capsule (mark + name + note); variants `.on` `.quiet` `.line`."
    },
    {
      "id": "callout.sentence@1",
      "category": "surface.callout",
      "roots": [
        "callout"
      ],
      "structure": "`.callout` — one sentence that concludes the page, written as `<p>문장 <b>핵심 구절</b></p>`, optional `.icon` before it."
    },
    {
      "id": "tag.inline@1",
      "category": "surface.tag",
      "roots": [
        "tag",
        "hl"
      ],
      "structure": "`.tag` — a small label inside a part; `.hl` — a highlight inside running text."
    },
    {
      "id": "list.items@1",
      "category": "content.list",
      "roots": [
        "list"
      ],
      "members": {
        "min": 2,
        "max": 8
      },
      "structure": "`.list` > `.item` (`.name` + `.note`) — the element draws each item's marker: a dot, a tick on `.list.check`, the item's number on `.list.num`; `.list.divided` rules the items apart. Never write numbers into the items. An item's own `.mark` holds only an icon."
    },
    {
      "id": "quote.voice@1",
      "category": "content.quote",
      "roots": [
        "quote"
      ],
      "structure": "`.quote` > `<blockquote>` + `.by` (`.seat.avatar` + `.name` + `.note`) — variant `.quote.big`."
    },
    {
      "id": "metric.figure@1",
      "category": "data.metric",
      "roots": [
        "stat",
        "stats"
      ],
      "members": {
        "min": 1,
        "max": 6
      },
      "structure": "`.stat` > `.parts` (`.fig` + `.name` + `.note`) — a bare figure without a surface; `.stats` > `.stat` × n a row of them with dividers."
    },
    {
      "id": "delta.change@1",
      "category": "data.delta",
      "roots": [
        "delta"
      ],
      "structure": "`.delta` — `<span class=\"from\">12.1억</span><span class=\"to\">15.6억</span>` before → after; the arrow is drawn by the element."
    },
    {
      "id": "chart.bar@1",
      "category": "data.chart-bar",
      "roots": [
        "bars"
      ],
      "members": {
        "min": 2,
        "max": 12
      },
      "structure": "`.bars` `style=\"--max:N\"` > `.bar` `style=\"--v:N\"` (`<b>` value + `<span>` label; `.bar.on`, `.bar.tone-N`) — vertical bars; `.bars.h` horizontal."
    },
    {
      "id": "chart.line@1",
      "category": "data.chart-line",
      "roots": [
        "lines"
      ],
      "members": {
        "min": 3,
        "max": 12
      },
      "structure": "`.lines` `style=\"--max:N\"` > `.pt` `style=\"--v:N\"` (`<b>` + `<span>`) — a line over equal steps, drawn by the element from the points."
    },
    {
      "id": "chart.donut@1",
      "category": "data.chart-donut",
      "roots": [
        "donut",
        "donuts"
      ],
      "members": {
        "min": 1,
        "max": 4
      },
      "structure": "`.donut` `style=\"--v:N\"` (0–100) > `.fig` + `.name` — one share of a whole; `.donuts` > `.donut` × n a row of them."
    },
    {
      "id": "gauge.meter@1",
      "category": "data.gauge",
      "roots": [
        "meter"
      ],
      "structure": "`.meter` `style=\"--v:N\"` (0–100) > `.name` + `.fig` — a horizontal progress bar; several stack in a `.stack`."
    },
    {
      "id": "table.grid@1",
      "category": "data.table",
      "roots": [
        "tablebox"
      ],
      "structure": "`.tablebox` > `<table class=\"table\">` with explicit `<thead>`/`<tbody>`; `.pick` on the cells of the column that is the point; `.num` on numeric cells."
    },
    {
      "id": "legend.keys@1",
      "category": "data.legend",
      "roots": [
        "legend"
      ],
      "structure": "`.legend` > `.key.tone-N` — a chart legend."
    },
    {
      "id": "steps.sequence@1",
      "category": "relationship.steps",
      "roots": [
        "steps"
      ],
      "members": {
        "min": 2,
        "max": 6
      },
      "structure": "`.steps` > `.step` (`.mark` number + `.name` + `.note`) — joined left to right by the element's connector; `.steps.col` downward."
    },
    {
      "id": "timeline.track@1",
      "category": "relationship.timeline",
      "roots": [
        "track"
      ],
      "members": {
        "min": 3,
        "max": 8
      },
      "structure": "`.track` > `.stop` (`.kick` date + `.name` + `.note`; `.stop.on`) — points on a line; `.track.alt` alternates above/below; `.track.col` runs downward."
    },
    {
      "id": "cycle.nodes@1",
      "category": "relationship.cycle",
      "roots": [
        "cycle"
      ],
      "members": {
        "min": 3,
        "max": 6
      },
      "structure": "`.cycle` > `.core` + `.node` × 3–6 — members around a centre, arrows drawn by the element."
    },
    {
      "id": "hub.spokes@1",
      "category": "relationship.hub",
      "roots": [
        "hub"
      ],
      "members": {
        "min": 3,
        "max": 6
      },
      "structure": "`.hub` > `.core` + `.spoke` × 3–6 (`.mark` + `.name` + `.note`) — a centre with members on spokes."
    },
    {
      "id": "funnel.stages@1",
      "category": "relationship.funnel",
      "roots": [
        "funnel"
      ],
      "members": {
        "min": 3,
        "max": 6
      },
      "structure": "`.funnel` > `.stage` × 3–6 (`.name` + `.fig`), each `style=\"--v:N\"` (0–100) for its width."
    },
    {
      "id": "pyramid.levels@1",
      "category": "relationship.pyramid",
      "roots": [
        "pyramid"
      ],
      "members": {
        "min": 3,
        "max": 5
      },
      "structure": "`.pyramid` > `.level` × 3–5 (`.name` + `.note`)."
    },
    {
      "id": "matrix.quadrants@1",
      "category": "relationship.matrix",
      "roots": [
        "matrix"
